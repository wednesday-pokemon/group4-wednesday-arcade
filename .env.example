# Browser-safe values ONLY. Never put the service_role key here.
# Leave both blank to run in LOCAL DEMO mode (unverified, single-browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3D Pokémon models (optional). Provider order, first hit wins: local (public/models/pokemon, npm run art:models3d)
# then community (the Pokémon 3D API). "off" = PokéAPI artwork only. Per page: ?pokemon3d=local|community|off
VITE_POKEMON_MODEL_PROVIDERS=local,community
VITE_POKEMON_3D_API=https://pokemon-3d-api.onrender.com/v1/pokemon
